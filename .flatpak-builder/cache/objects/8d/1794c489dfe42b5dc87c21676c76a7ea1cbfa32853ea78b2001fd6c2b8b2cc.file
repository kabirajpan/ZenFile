[Application]
name=org.zenthra.ZenFile
runtime=org.freedesktop.Platform/x86_64/24.08
sdk=org.freedesktop.Sdk/x86_64/24.08
command=file-manager

[Context]
shared=network;
sockets=x11;wayland;fallback-x11;
devices=dri;all;
filesystems=host;

[Extension org.zenthra.ZenFile.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=org.zenthra.ZenFile.Debug;